<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="org.example.todoapp.controller.AddCategoryController"
        spacing="18"
        stylesheets="@../styles/categories.css"
        styleClass="category-modal">

    <padding>
        <Insets
                top="25"
                right="25"
                bottom="25"
                left="25"/>
    </padding>


    <!-- HEADER -->

    <VBox spacing="4">

        <Label
                text="Create Category"
                styleClass="modal-title"/>

        <Label
                text="Add a category to organize your todos."
                styleClass="modal-subtitle"/>

    </VBox>


    <!-- CATEGORY NAME -->

    <VBox spacing="7">

        <Label
                text="Category name"
                styleClass="field-label"/>

        <TextField
                fx:id="titleField"
                promptText="e.g. Work, Personal, Study"
                styleClass="text-field"/>

    </VBox>


    <!-- COLOR -->

    <VBox spacing="7">

        <Label
                text="Color"
                styleClass="field-label"/>

        <ColorPicker
                fx:id="colorPicker"
                styleClass="color-picker"/>

    </VBox>


    <!-- BUTTONS -->

    <HBox
            alignment="CENTER_RIGHT"
            spacing="10">

        <Button
                text="Cancel"
                onAction="#handleCancel"
                styleClass="cancel-btn"/>

        <Button
                text="Create Category"
                onAction="#handleCreate"
                styleClass="create-btn"/>

    </HBox>

</VBox>